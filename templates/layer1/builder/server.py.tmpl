#!/usr/bin/env python3
"""Layer 1 builder server — the chat a non-coder uses to drive the factory.

Minimal, stdlib-only. Serves a chat page and, on each message, runs the factory
headlessly (`claude -p`) against the project and returns the plain-language
reply. Runs the factory with --dangerously-skip-permissions, so it MUST run
inside the container (see ../Dockerfile), never on a host with real access.

Security (defense in depth — this drives an unsandboxed agent over a mounted repo):
  * Binds 127.0.0.1 only. docker-compose maps 127.0.0.1:PORT so it is never on
    the LAN. Do NOT change that mapping to 0.0.0.0.
  * Requires a shared token (X-Builder-Token header) on /chat. BUILDER_TOKEN is
    read from the env; if unset a random one is generated at startup, printed to
    the log, and injected into the served page — so the bundled UI just works
    while curl/other origins are rejected (401).
  * Validates the Host header (localhost/127.0.0.1 only) to defeat DNS-rebinding
    from a browser the user happens to have open (403 otherwise).
  * Single-flight: one build at a time. A second concurrent request gets 409
    'busy' instead of racing `claude` processes on one git index.

Env:
  PROJECT_DIR   path to the project the factory edits (default: /app)
  BUILDER_PORT  port to listen on (default: 8080)
  CLAUDE_BIN    claude binary (default: claude)
  BUILDER_MODEL optional model override
  BUILDER_TOKEN shared secret for /chat (default: random per start)
"""
import hmac
import json
import os
import secrets
import subprocess
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PROJECT_DIR = os.environ.get("PROJECT_DIR", "/app")
PORT = int(os.environ.get("BUILDER_PORT", "8080"))
CLAUDE_BIN = os.environ.get("CLAUDE_BIN", "claude")
MODEL = os.environ.get("BUILDER_MODEL", "")
TOKEN = os.environ.get("BUILDER_TOKEN") or secrets.token_urlsafe(24)
HERE = Path(__file__).resolve().parent

# One build at a time — concurrent `claude` runs on one git repo race the index.
_BUILD_LOCK = threading.Lock()
_ALLOWED_HOSTNAMES = {"127.0.0.1", "localhost", "::1", "[::1]"}


def host_ok(host_header):
    """True if the Host header points at loopback. Defeats DNS-rebinding: an
    attacker page can force a request to 127.0.0.1 but cannot forge Host."""
    if not host_header:
        return False
    h = host_header.strip()
    if h.startswith("["):                 # bracketed IPv6, e.g. [::1]:8080
        h = h[: h.index("]") + 1] if "]" in h else h
    elif ":" in h:                        # host:port (IPv4 or name)
        h = h.rsplit(":", 1)[0]
    return h in _ALLOWED_HOSTNAMES


def token_ok(provided):
    """Constant-time compare of the supplied token against the server token."""
    return hmac.compare_digest(provided or "", TOKEN)


def project_name():
    try:
        cfg = json.loads((Path(PROJECT_DIR) / "factory.config.json").read_text())
        return cfg.get("project", {}).get("name", "your app")
    except Exception:
        return "your app"


def run_factory(prompt):
    """Drive the factory once. The builder-orchestrator agent replies in plain
    language. Returns (ok, text)."""
    instruction = (
        "You are the builder-orchestrator (.claude/agents/builder-orchestrator.md). "
        "A non-technical user said:\n\n" + prompt +
        "\n\nDrive the factory to satisfy it. Reply ONLY in plain language about "
        "what changed for them — never file paths, code, or agent names."
    )
    cmd = [CLAUDE_BIN, "-p", instruction, "--dangerously-skip-permissions"]
    if MODEL:
        cmd += ["--model", MODEL]
    try:
        proc = subprocess.run(cmd, cwd=PROJECT_DIR, capture_output=True,
                              text=True, timeout=3600)
        if proc.returncode != 0:
            return False, "Something went wrong building that. Want me to try again?"
        return True, proc.stdout.strip() or "Done."
    except Exception as e:
        return False, f"The builder couldn't run: {e}"


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json"):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if not host_ok(self.headers.get("Host")):
            return self._send(403, json.dumps({"error": "forbidden host"}))
        if self.path in ("/", "/index.html"):
            page = (HERE / "index.html").read_text().replace("__BUILDER_TOKEN__", TOKEN)
            self._send(200, page, "text/html")
        elif self.path == "/health":
            self._send(200, json.dumps({"ok": True, "project": project_name()}))
        else:
            self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        if not host_ok(self.headers.get("Host")):
            return self._send(403, json.dumps({"error": "forbidden host"}))
        if self.path != "/chat":
            return self._send(404, json.dumps({"error": "not found"}))
        if not token_ok(self.headers.get("X-Builder-Token")):
            return self._send(401, json.dumps({"error": "unauthorized"}))
        if not _BUILD_LOCK.acquire(blocking=False):
            return self._send(409, json.dumps(
                {"ok": False, "reply": "I'm still working on the last request — "
                                       "one moment, then try again."}))
        try:
            length = int(self.headers.get("Content-Length", "0"))
            try:
                payload = json.loads(self.rfile.read(length) or b"{}")
            except Exception:
                return self._send(400, json.dumps({"error": "bad json"}))
            prompt = (payload.get("prompt") or "").strip()
            if not prompt:
                return self._send(400, json.dumps({"error": "empty prompt"}))
            ok, text = run_factory(prompt)
            self._send(200, json.dumps({"ok": ok, "reply": text}))
        finally:
            _BUILD_LOCK.release()

    def log_message(self, *args):
        pass  # quiet


def main():
    print(f"Builder for '{project_name()}' on http://127.0.0.1:{PORT} "
          f"(project: {PROJECT_DIR})")
    if not os.environ.get("BUILDER_TOKEN"):
        print(f"[builder] generated session token: {TOKEN}")
        print("[builder] the bundled chat page is pre-authorized; external "
              "clients must send X-Builder-Token.")
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
